---
import { getContentSeo, getEmDashEntry, getSeoMeta, getSiteSettings } from "emdash";
import Base from "../layouts/Base.astro";
import PageView from "../components/PageView.astro";
import { heroSeoDefaults } from "../utils/page";
import { resolveSiteIdentity } from "../utils/site";

const [{ entry: page, cacheHint }, settings] = await Promise.all([
	getEmDashEntry("pages", "home"),
	getSiteSettings(),
]);

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const { siteTitle, siteTagline } = resolveSiteIdentity(settings);
const seo = page
	? getSeoMeta(page, {
			siteUrl: Astro.url.origin,
			path: "/",
			...heroSeoDefaults(page.data.content, Astro.url.origin),
		})
	: null;
// The home page is titled after the site unless its SEO panel sets a title.
const seoTitle = page ? getContentSeo(page)?.title || undefined : undefined;
const first = page?.data.content?.[0] as { _type?: string; hero?: boolean | null } | undefined;
// a full-bleed photo or video opens the page: the bar starts white on dark
const headerTone = first?._type === "lm_hero_video" || (first?._type === "lm_shootday_clips" && first.hero) ? "media" : "paper";
---

<Base
	title={seoTitle}
	pageTitle={seoTitle}
	description={seo?.description}
	image={seo?.ogImage}
	canonical={seo?.canonical}
	robots={seo?.robots}
	content={page ? { collection: "pages", id: page.data.id, slug: page.id } : undefined}
	headerTone={headerTone}
>
	{
		page ? (
			<PageView page={page} heading={siteTitle} />
		) : (
			<section class="container" style="padding-block:180px 120px">
				<h1 class="h1">{siteTitle}</h1>
				{siteTagline && <p class="text-l muted" style="margin-top:24px">{siteTagline}</p>}
				{Astro.locals.user && (
					<p style="margin-top:24px">
						<a class="text-link" href="/_emdash/admin/content/pages/new">Maak een pagina met de slug “home”</a>
					</p>
				)}
			</section>
		)
	}
</Base>
