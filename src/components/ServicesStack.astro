---
/**
 * Services as stacking cards (Doop component ServiceCard, after Get Hyped):
 * each card sticks near the top and the next one slides over it, while the
 * card underneath tips back in 3D (narrower at the top, smaller, darker) and
 * fades away (motion.ts, data-services-stack). White card: number, title with
 * an accent word, summary, button; a photo on the right up to the card's edge,
 * only its left side slanted.
 */
import { Image } from "emdash/ui";
import Button from "./Button.astro";
import { headlineParts } from "../utils/text";

interface Props {
	services: { id: string; data: { title: string; card_title?: string | null; card_text?: string | null; summary?: string | null; image?: unknown } }[];
	anchor?: string | null;
	buttonLabel?: string | null;
}

const { services, anchor, buttonLabel } = Astro.props;
const pad = (n: number) => String(n).padStart(2, "0");
// Max: first card white, second red, third black, each with its own tone-on-tone scribble
const TONES = [
	{ tone: "white", scribble: "/assets/scribbles/circle-paper-tone.png", button: "solid" },
	{ tone: "red", scribble: "/assets/scribbles/loops-red-tone.png", button: "white" },
	{ tone: "ink", scribble: "/assets/scribbles/swirl-ink-tone.png", button: "white" },
] as const;
---

<section class="ss" id={anchor || undefined} data-services-stack>
	<div class="container">
		<ol class="ss__list" style={`--n:${services.length}`}>
			{
				services.map((s, i) => (
					<li class="ss__item" style={`--i:${i}`} data-stack-item>
						<article class:list={["ss__card", { "ss__card--flip": i % 2 === 1 }]} data-tone={TONES[i % 3].tone} data-stack-card>
							<img class="ss__tone" src={TONES[i % 3].scribble} alt="" aria-hidden="true" />
							<div class="ss__txt">
								<span class="mono ss__no">{pad(i + 1)}</span>
								<h2 class="ss__title">
									{headlineParts(s.data.card_title || s.data.title).map((p) => (p.kind === "plain" ? p.text : <em>{p.text}</em>))}
								</h2>
								{(s.data.card_text || s.data.summary) && <p class="ss__body">{s.data.card_text || s.data.summary}</p>}
								<Button label={buttonLabel || "Bekijk deze dienst"} href={`/diensten/${s.id}`} tone={TONES[i % 3].button} />
							</div>
							<div class="ss__ph">
								<div class="ss__ph-in">
									<div class="ss__ph-cut">{s.data.image && <Image image={s.data.image as never} sizes="(min-width: 900px) 46vw, 100vw" />}</div>
								</div>
							</div>
						</article>
					</li>
				))
			}
		</ol>
	</div>
</section>

<style>
	.ss {
		/* no extra bottom padding: the room after the last card already gives the gap (Max) */
		padding-block: var(--section-space) 0;
	}
	.ss__list {
		display: flex;
		flex-direction: column;
		/* room after the last card, so the full stack holds for a moment before it leaves */
		padding-bottom: 18vh;
	}
	.ss__item {
		/* each card sticks a little lower than the one before, so their tops stack */
		position: sticky;
		--step: 22px;
		top: calc(100px + var(--i) * var(--step));
		/* room under each card, so the stacked tops stay staggered while the stack leaves */
		padding-bottom: calc((var(--n) - 1 - var(--i)) * var(--step));
		perspective: 1400px;
	}
	.ss__item + .ss__item {
		margin-top: 32vh;
	}
	.ss__card {
		position: relative;
		display: grid;
		grid-template-columns: minmax(0, 1fr) 46%;
		/* tall cards, measured on the screen height (Max); leaves room for the stacked tops */
		--card-h: clamp(480px, 76svh, 820px);
		height: var(--card-h);
		overflow: hidden;
		border-radius: var(--radius-media);
		background: var(--color-white);
		box-shadow: 0 -20px 60px rgba(18, 18, 18, 0.06);
		transform-origin: 50% 0;
		will-change: transform;
	}
	/* on a white page (e.g. /diensten) the white card would vanish: it turns light grey */
	:global(html:has(.hc)) .ss__card[data-tone="white"] {
		background: var(--color-paper);
	}
	.ss__card[data-tone="red"] {
		background: var(--gradient-rec);
		color: var(--color-white);
	}
	.ss__card[data-tone="ink"] {
		background: var(--color-ink);
		color: var(--color-white);
	}
	/* a large tone-on-tone scribble behind the text, a different one per card */
	/* smaller and quieter than first (Max) */
	.ss__tone {
		position: absolute;
		left: -4%;
		bottom: -16%;
		width: 40%;
		max-width: none;
		opacity: 0.55;
		pointer-events: none;
	}
	.ss__card[data-tone="red"] .ss__tone {
		/* big loops filling the bottom-right corner, running off the edges */
		left: auto;
		right: -9%;
		bottom: -16%;
		width: 50%;
		opacity: 0.4;
		transform: rotate(-8deg);
	}
	.ss__card[data-tone="ink"] .ss__tone {
		left: -6%;
		bottom: -22%;
		width: 38%;
		opacity: 0.6;
	}
	.ss__txt,
	.ss__ph {
		position: relative;
	}
	/* darkens as the card tips away (motion.ts sets --dim) */
	.ss__card::after {
		content: "";
		position: absolute;
		inset: 0;
		background: var(--color-ink);
		opacity: var(--dim, 0);
		pointer-events: none;
	}
	.ss__txt {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		padding: clamp(28px, 3.4vw, 48px);
	}
	.ss__no {
		color: var(--color-rec);
	}
	.ss__card[data-tone="red"] .ss__no {
		color: rgba(255, 255, 255, 0.8);
	}
	.ss__title {
		margin-top: 20px;
		font-family: var(--font-display);
		font-weight: 600;
		font-size: var(--text-h2);
		letter-spacing: -0.045em;
		line-height: 0.95;
	}
	.ss__body {
		max-width: 500px;
		margin: auto 0 28px;
		font-size: var(--text-m);
		line-height: 1.6;
		color: var(--color-mute);
	}
	.ss__card[data-tone="red"] .ss__body,
	.ss__card[data-tone="ink"] .ss__body {
		color: rgba(255, 255, 255, 0.82);
	}
	/* photo with a small margin inside the card (Max); right corners rounded,
	   only the left side follows the brand slant */
	.ss__ph {
		height: 100%;
		padding: 12px 12px 12px 0;
	}
	.ss__ph-in {
		position: relative;
		height: 100%;
		overflow: hidden;
		border-radius: var(--radius-sm);
	}
	.ss__ph-cut {
		position: absolute;
		inset: 0;
		--slant-x: calc((var(--card-h) - 24px) * 0.2254);
		clip-path: polygon(0 0, 100% 0, 100% 100%, var(--slant-x) 100%);
	}
	/* every second card: photo on the left, its slanted side on the right (Max) */
	.ss__card--flip {
		grid-template-columns: 46% minmax(0, 1fr);
	}
	.ss__card--flip .ss__ph {
		grid-column: 1;
		grid-row: 1;
		padding: 12px 0 12px 12px;
	}
	.ss__card--flip .ss__txt {
		grid-column: 2;
		grid-row: 1;
	}
	.ss__card--flip .ss__ph-cut {
		clip-path: polygon(0 0, calc(100% - var(--slant-x)) 0, 100% 100%, 0 100%);
	}
	.ss__ph :global(img) {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		max-width: none;
		object-fit: cover;
	}
	@media (max-width: 899px) {
		.ss__item {
			--step: 14px;
			top: calc(84px + var(--i) * var(--step));
		}
		.ss__item + .ss__item {
			margin-top: 24vh;
		}
		/* photo on top, text under it */
		.ss__card {
			grid-template-columns: 1fr;
			grid-template-rows: 200px auto;
			height: auto;
		}
		.ss__ph,
		.ss__card--flip .ss__ph {
			grid-column: 1;
			grid-row: 1;
			padding: 10px 10px 0;
		}
		.ss__card--flip {
			grid-template-columns: 1fr;
		}
		.ss__card--flip .ss__txt {
			grid-column: 1;
			grid-row: 2;
		}
		.ss__card--flip .ss__ph-cut {
			clip-path: none;
		}
		.ss__ph-cut {
			clip-path: none;
		}
		.ss__body {
			margin: 20px 0 24px;
		}
	}
</style>
