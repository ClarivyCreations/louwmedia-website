---
/** Renders a headline string with *accent* and _marker_ words (see utils/text.ts). */
import { headlineParts } from "../utils/text";
import { scribbleSvg, scribblesOf } from "../utils/scribbles";

interface Props {
	text: string;
	as?: "h1" | "h2" | "h3" | "blockquote" | "p";
	class?: string;
	reveal?: boolean;
}

const { text, as: Tag = "h2", class: className, reveal = true } = Astro.props;
const parts = headlineParts(text);
const line = scribblesOf("line")[0];
---

<Tag class={className} data-reveal={reveal ? "lines" : undefined}>
	{
		parts.map((p) =>
			p.kind === "accent" ? (
				<em>{p.text}</em>
			) : p.kind === "marker" ? (
				<span class="marker" data-scribble="line">
					{p.text}
					<span class="scrib__mark" set:html={scribbleSvg(line)} />
				</span>
			) : (
				p.text
			),
		)
	}
</Tag>

<style>
	.marker {
		position: relative;
		white-space: nowrap;
	}
	.marker .scrib__mark {
		left: -0.08em;
		bottom: -0.2em;
		width: calc(100% + 0.2em);
		height: 0.34em;
	}
</style>
