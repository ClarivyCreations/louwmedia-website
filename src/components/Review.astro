---
/**
 * A client review (Max): optional score with stars (Google gets its G), the
 * quote large with a _marker_ phrase, and a small slanted photo with name and
 * role. Used next to the FAQ (lm_faq) and on case pages. Doop component "Review".
 */
import Headline from "./Headline.astro";
import SlantPhoto from "./SlantPhoto.astro";

interface Props {
	quote: string;
	name?: string | null;
	role?: string | null;
	image?: unknown;
	rating?: string | null;
	ratingSource?: string | null;
	class?: string;
}
const { quote, name, role, image, rating, ratingSource, class: className } = Astro.props;
const score = rating?.trim();
const google = /google/i.test(ratingSource ?? "");
---

<figure class:list={["rv", className]}>
	{
		score && (
			<p class="text-s rv__score">
				{google && (
					<svg class="rv__g" viewBox="0 0 48 48" aria-hidden="true">
						<path fill="#FFC107" d="M43.6 20.1H42V20H24v8h11.3c-1.6 4.7-6.1 8-11.3 8-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.8 1.2 8 3l5.7-5.7C34 6.1 29.3 4 24 4 13 4 4 13 4 24s9 20 20 20 20-9 20-20c0-1.3-.1-2.6-.4-3.9z" />
						<path fill="#FF3D00" d="m6.3 14.7 6.6 4.8C14.7 15.1 19 12 24 12c3.1 0 5.8 1.2 8 3l5.7-5.7C34 6.1 29.3 4 24 4 16.3 4 9.7 8.3 6.3 14.7z" />
						<path fill="#4CAF50" d="M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.2c-2 1.5-4.5 2.4-7.2 2.4-5.2 0-9.6-3.3-11.3-7.9l-6.5 5C9.5 39.6 16.2 44 24 44z" />
						<path fill="#1976D2" d="M43.6 20.1H42V20H24v8h11.3c-.8 2.2-2.2 4.2-4.1 5.6l6.2 5.2C37 39.2 44 34 44 24c0-1.3-.1-2.6-.4-3.9z" />
					</svg>
				)}
				<strong>{score}</strong>
				<span class="rv__stars" aria-label={`${score} van de 5 sterren`}>
					{[0, 1, 2, 3, 4].map(() => (
						<svg viewBox="0 0 13 13" aria-hidden="true"><path d="M6.5 0l1.9 4.1 4.4.5-3.3 3 .9 4.4-3.9-2.2-3.9 2.2.9-4.4-3.3-3 4.4-.5z" /></svg>
					))}
				</span>
				{ratingSource && <span class="muted">op {ratingSource}</span>}
			</p>
		)
	}
	<Headline text={`“${quote}”`} as="blockquote" class="rv__quote" />
	{
		(name || role) && (
			<figcaption class="rv__who">
				{image && <SlantPhoto image={image} as="span" class="rv__avatar" sizes="96px" />}
				<span>
					{name && <span class="rv__name">{name}</span>}
					{role && <span class="text-s muted rv__role">{role}</span>}
				</span>
			</figcaption>
		)
	}
</figure>

<style>
	.rv__score {
		display: flex;
		align-items: center;
		gap: 10px;
		margin-bottom: 28px;
	}
	.rv__score strong {
		font-weight: 600;
	}
	.rv__g {
		width: 16px;
		height: 16px;
	}
	.rv__stars {
		display: flex;
		gap: 3px;
	}
	.rv__stars svg {
		width: 13px;
		height: 13px;
		fill: var(--color-rec);
	}
	.rv :global(.rv__quote) {
		font-family: var(--font-display);
		font-weight: 600;
		font-size: var(--text-h4);
		line-height: 1.2;
		letter-spacing: -0.03em;
	}
	.rv__who {
		display: flex;
		align-items: center;
		gap: 14px;
		margin-top: 28px;
	}
	.rv :global(.rv__avatar) {
		display: block;
		width: 48px;
		height: 58px;
		margin-left: 6px;
		flex: none;
		border-radius: var(--radius-sm);
	}
	.rv__name {
		display: block;
		font-weight: 600;
	}
	.rv__role {
		display: block;
		margin-top: 2px;
	}
</style>
