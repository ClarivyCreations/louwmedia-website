---
/**
 * S23b · Shoot day in beeld (Doop "Secties", Max): one large frame in which
 * the moments of a shoot day take turns, each new one wiping in from the right
 * on the brand slant (12.7°). The headline sits bottom left over the picture;
 * bottom right a list of the moments (thumbnail, title, time and place) with a
 * progress bar on the one that is showing; a click jumps to that moment. Each
 * moment is a photo, optionally with a muted video that loads once in view.
 * No play button and no sound here (Max 2026-11-22). Behaviour in scripts/clips.ts. Mobile: the list sits under the frame.
 */
import { Image, type BlockComponentProps } from "emdash/ui";
import type { PageContentBlock } from "../../../emdash-env";
import Headline from "../Headline.astro";
import Tag from "../Tag.astro";

type Block = Extract<PageContentBlock, { _type: "lm_shootday_clips" }>;
type Props = BlockComponentProps<Block>;

const { value } = Astro.props;
type File = { provider?: string; src?: string; url?: string; meta?: Record<string, unknown> } | null | undefined;
const urlOf = (file: File) => {
	const key = typeof file?.meta?.storageKey === "string" ? file.meta.storageKey : undefined;
	return key ? Astro.locals.emdash?.getPublicMediaUrl?.(key) : file?.provider === "external" ? file.src : file?.url;
};
const v = value as unknown as Record<string, unknown>;
const moments = [1, 2, 3, 4]
	.map((i) => ({
		image: v[`image_${i}`] as never,
		video: urlOf(v[`video_${i}`] as File),
		title: (v[`title_${i}`] as string | null) ?? "",
		time: (v[`time_${i}`] as string | null) ?? "",
		place: (v[`place_${i}`] as string | null) ?? "",
	}))
	.filter((m) => m.image && m.title);
const hero = Boolean((value as { hero?: boolean | null }).hero);
const intro = hero ? "rest" : undefined;
const tag = value.tag || "Shoot day";
const tagText = (time: string) => (time ? `${tag} · ${time}` : tag);
---

{
	moments.length > 0 && (
		<section class:list={["sc", hero && "sc--hero"]} id={value.anchor_id || undefined} data-clips data-hero={hero ? "clips" : undefined}>
			<div class="sc__in">
				{value.note && !hero && (
					<p class="sc__note" aria-hidden="true">
						{value.note}
					</p>
				)}
				<div class="sc__stage" data-reveal={hero ? undefined : ""}>
					<div class="sc__media" data-intro={hero ? "media" : undefined}>
						{moments.map((m, i) => (
							<div class:list={["sc__layer", i === 0 && "is-in is-current"]} data-clip={i} data-time={tagText(m.time)}>
								<Image image={m.image} class="sc__img" sizes="100vw" loading={i === 0 ? "eager" : "lazy"} fetchpriority={hero && i === 0 ? "high" : undefined} />
								{m.video && <video class="sc__video" data-src={m.video} muted loop playsinline preload="none" aria-hidden="true" />}
							</div>
						))}
					</div>
					<span class="sc__shade" aria-hidden="true" />
					<Tag text={tagText(moments[0].time)} class="sc__tag" data-clips-tag data-intro={intro} />
					<Headline text={value.headline} as={hero ? "h1" : "h2"} class="h1 sc__title" reveal={false} />
				</div>
				<div class="sc__side" data-intro={intro}>
					{value.note && hero && (
						<p class="sc__note sc__note--side" aria-hidden="true">
							{value.note}
						</p>
					)}
					{value.intro && <p class="text-s sc__intro">{value.intro}</p>}
					<ol class="sc__list">
						{moments.map((m, i) => (
							<li>
								<button class:list={["sc__item", i === 0 && "is-current"]} type="button" data-clips-go={i} aria-pressed={i === 0 ? "true" : "false"}>
									<span class="sc__thumb">
										<Image image={m.image} sizes="120px" />
									</span>
									<span class="sc__txt">
										<span class="sc__t">{m.title}</span>
										<span class="mono sc__m">{[m.time, m.place].filter(Boolean).join(" · ")}</span>
										<span class="sc__bar" aria-hidden="true">
											<i />
										</span>
									</span>
								</button>
							</li>
						))}
					</ol>
				</div>
			</div>
		</section>
	)
}

<style>
	.sc {
		padding: var(--section-space) 0 clamp(48px, 5vw, 80px);
		overflow-x: clip;
		background: var(--color-white);
	}
	/* full width (Max); frame and moment list share one grid cell on desktop, the list sits
	   bottom right over the picture. Text inside lines up with the boxed content via --edge */
	.sc__in {
		position: relative;
		display: grid;
	}
	.sc__stage,
	.sc__side {
		grid-area: 1 / 1;
	}
	.sc__stage {
		position: relative;
		aspect-ratio: 16 / 9;
		max-height: 86svh;
		width: 100%;
		container-type: size;
		overflow: hidden;
		background: var(--color-ink);
		color: var(--color-white);
		isolation: isolate;
	}
		/* the slant's horizontal run is tan(12.7°) × the frame's height, so it stays 12.7° at any ratio */
	.sc__media {
		position: absolute;
		inset: 0;
	}
	.sc__layer {
		--s: 22.54cqh;
		position: absolute;
		inset: 0;
		clip-path: polygon(calc(100% + var(--s)) 0, 100% 0, 100% 100%, 100% 100%);
	}
	.sc__layer.is-in {
		clip-path: polygon(0 0, 100% 0, 100% 100%, calc(0% - var(--s)) 100%);
	}
	.sc__layer.is-wiping {
		transition: clip-path 1.1s cubic-bezier(0.65, 0, 0.2, 1);
	}
	.sc__layer :global(.sc__img),
	.sc__video {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	.sc__video {
		opacity: 0;
		transition: opacity 0.4s;
	}
	.sc__video.is-on {
		opacity: 1;
	}
	.sc__shade {
		position: absolute;
		inset: 0;
		z-index: 5;
		pointer-events: none;
		background:
			linear-gradient(180deg, rgba(18, 18, 18, 0) 40%, rgba(18, 18, 18, 0.72) 100%),
			linear-gradient(270deg, rgba(18, 18, 18, 0.66) 0, rgba(18, 18, 18, 0.4) 28%, rgba(18, 18, 18, 0) 46%);
	}
	.sc__stage :global(.sc__tag) {
		position: absolute;
		z-index: 6;
		left: var(--edge);
		top: clamp(20px, 3vw, 36px);
		color: var(--color-white);
	}
	.sc__stage :global(.sc__title) {
		position: absolute;
		z-index: 6;
		left: var(--edge);
		bottom: clamp(24px, 3.4vw, 48px);
		max-width: 8em;
		font-size: min(var(--text-h1), 6.2vw);
		color: var(--color-white);
	}

	/* the moments, over the frame on the right (desktop) */
	.sc__side {
		position: relative;
		z-index: 6;
		align-self: end;
		justify-self: end;
		margin: 0 var(--edge) clamp(24px, 3vw, 40px) 0;
		width: min(340px, 30%);
		color: var(--color-white);
	}
	.sc__intro {
		margin-bottom: 16px;
		color: rgba(255, 255, 255, 0.85);
	}
	.sc__item {
		display: grid;
		grid-template-columns: 96px 1fr;
		gap: 12px;
		align-items: center;
		width: 100%;
		padding: 8px 0;
		border: 0;
		border-top: 1px solid rgba(255, 255, 255, 0.18);
		background: none;
		color: inherit;
		font: inherit;
		text-align: left;
		cursor: pointer;
	}
	.sc__thumb {
		display: block;
		width: 96px;
		height: 56px;
		border-radius: var(--radius-sm, 4px);
		overflow: hidden;
		outline: 2px solid transparent;
		outline-offset: 2px;
		transition: outline-color 0.3s;
	}
	.sc__thumb :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.6s var(--ease-out);
	}
	.sc__item:hover .sc__thumb :global(img) {
		transform: scale(1.06);
	}
	.sc__item.is-current .sc__thumb {
		outline-color: var(--color-rec);
	}
	.sc__t {
		display: block;
		font-family: var(--font-display);
		font-weight: 600;
		font-size: var(--text-s);
		letter-spacing: -0.01em;
	}
	.sc__m {
		display: block;
		margin-top: 2px;
		text-transform: none;
		opacity: 0.6;
	}
	.sc__bar {
		display: block;
		height: 2px;
		margin-top: 6px;
		background: rgba(255, 255, 255, 0.2);
		opacity: 0;
		transition: opacity 0.3s;
	}
	.sc__bar i {
		display: block;
		width: 100%;
		height: 100%;
		background: var(--color-rec);
		transform: scaleX(var(--p, 0));
		transform-origin: left;
	}
	.sc__item.is-current .sc__bar {
		opacity: 1;
	}
	.sc__note {
		position: absolute;
		z-index: 7;
		right: calc(var(--edge) + 80px);
		top: -50px;
		font-family: var(--font-scribble);
		font-size: var(--text-h5);
		line-height: 1.1;
		color: var(--color-rec);
		white-space: nowrap;
		transform: rotate(-5deg);
		pointer-events: none;
	}

	/* as the page opener (field "hero"): full screen, the header sits over it (Max) */
	/* nothing above or below it on desktop: the grey section follows right under the picture (Max) */
	.sc--hero {
		padding: 0;
	}
	.sc--hero .sc__stage {
		aspect-ratio: auto;
		height: 100svh;
		min-height: 620px;
		max-height: none;
	}
	.sc--hero .sc__shade {
		background:
			linear-gradient(180deg, rgba(18, 18, 18, 0.45) 0, rgba(18, 18, 18, 0) 24%),
			linear-gradient(180deg, rgba(18, 18, 18, 0) 40%, rgba(18, 18, 18, 0.72) 100%),
			linear-gradient(270deg, rgba(18, 18, 18, 0.66) 0, rgba(18, 18, 18, 0.4) 28%, rgba(18, 18, 18, 0) 46%);
	}
	.sc--hero .sc__stage :global(.sc__tag) {
		top: 118px;
	}
	.sc__note--side {
		position: static;
		display: block;
		width: max-content;
		margin: 0 0 14px auto;
	}

	@media (max-width: 999px) {
		.sc--hero {
			padding-bottom: 56px;
		}
		.sc--hero .sc__stage {
			height: 78svh;
			min-height: 500px;
		}
		.sc--hero .sc__shade {
			background:
				linear-gradient(180deg, rgba(18, 18, 18, 0.45) 0, rgba(18, 18, 18, 0) 24%),
				linear-gradient(180deg, rgba(18, 18, 18, 0) 45%, rgba(18, 18, 18, 0.72) 100%);
		}
		.sc--hero .sc__stage :global(.sc__tag) {
			top: 96px;
		}
		.sc__note--side {
			margin: 0 0 12px;
		}
		.sc__stage :global(.sc__title) {
			font-size: var(--text-h2);
		}
		.sc__stage {
			aspect-ratio: 4 / 5;
			max-height: none;
		}
		.sc__shade {
			background: linear-gradient(180deg, rgba(18, 18, 18, 0) 45%, rgba(18, 18, 18, 0.72) 100%);
		}
		.sc__side {
			grid-area: auto;
			width: auto;
			margin: 24px var(--gutter) 0;
			color: var(--color-ink);
		}
		.sc__intro {
			color: var(--color-mute);
		}
		.sc__item {
			border-top-color: var(--color-line);
		}
		.sc__bar {
			background: var(--color-line);
		}
		.sc__note {
			right: 16px;
			top: -40px;
		}
	}
</style>
