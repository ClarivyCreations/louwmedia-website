---
/**
 * S23a · Photos in a slowly turning circle (Doop "Secties", Max): square
 * photos on a large ring whose centre lies low in the section, each turned
 * along it, so the top of the ring forms an arc over the headline. The ring
 * turns slowly and keeps going (scripts/arc.ts, only while in view): photos
 * come up on the right, pass over the top and fade out on the left. The ring
 * is always full: 15 spots, 24° apart; the photos take turns round it. Photos only (Max 2026-11-21: simpler than videos).
 * Reduced motion: the ring stands still.
 */
import { Image, type BlockComponentProps } from "emdash/ui";
import type { PageContentBlock } from "../../../emdash-env";
import Headline from "../Headline.astro";

type Block = Extract<PageContentBlock, { _type: "lm_photo_arc" }>;
type Props = BlockComponentProps<Block>;

const { value } = Astro.props;
const items = (value.items ?? []).filter((t) => t.image);
// fill the whole ring at the design's spacing (24°, 15 spots; Max: room between
// the photos); the photos take turns round the ring (at most 12 in the CMS)
const n = items.length;
const step = 24;
const slots = n ? 360 / step : 0;
const angleOf = (i: number) => {
	const a = (i * step) % 360;
	return a > 180 ? a - 360 : a;
};
// same fade as scripts/arc.ts: full up to 75° from the top, gone at 110° (Max: show them earlier)
const fade = (a: number) => Math.max(0, Math.min(1, 1 - (Math.abs(a) - 75) / 35));
---

{
	n > 0 && (
		<section class="arc" id={value.anchor_id || undefined} data-arc>
			<div class="arc__ring" data-arc-ring aria-hidden="true">
				{Array.from({ length: slots }, (_, i) => {
					const t = items[i % n];
					const a = angleOf(i);
					return (
						<figure class="arc__tile" data-a={a} style={`--a: ${a}deg; opacity: ${fade(a)}`}>
							<Image image={t.image} class="arc__img" sizes="180px" loading={fade(a) > 0 ? undefined : "lazy"} />
							{t.time && <span class="mono arc__tc">{t.time}</span>}
						</figure>
					);
				})}
			</div>
			<div class="container arc__text">
				<Headline text={value.headline} class="h2 arc__title" />
				{value.intro && <p class="text-m muted arc__intro" data-reveal>{value.intro}</p>}
			</div>
			{value.note && <p class="arc__note" aria-hidden="true">{value.note}</p>}
		</section>
	)
}

<style>
	.arc {
		--r: clamp(230px, 39vw, 560px); /* radius of the ring */
		--tile: clamp(92px, calc(var(--r) * 0.3), 168px);
		--top: 48px; /* room above the top photo */
		--cy: calc(var(--r) + var(--tile) + var(--top)); /* centre of the ring, from the top */
		position: relative;
		overflow: hidden;
		min-height: calc(var(--cy) + var(--tile) * 0.6);
		padding-bottom: clamp(80px, 8vw, 128px);
		background: var(--color-white);
	}
	.arc__ring {
		--turn: 0deg;
		position: absolute;
		left: 50%;
		top: var(--cy);
		width: 0;
		height: 0;
	}
	.arc__tile {
		position: absolute;
		left: calc(var(--tile) / -2);
		top: calc(var(--tile) / -2);
		width: var(--tile);
		height: var(--tile);
		overflow: hidden;
		border-radius: var(--radius-media);
		background: var(--color-graphite);
		box-shadow: 0 18px 40px rgba(18, 18, 18, 0.12);
		transform: rotate(calc(var(--a) + var(--turn))) translateY(calc(var(--r) * -1));
	}
	.arc__tile :global(.arc__img) {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		max-width: none;
		object-fit: cover;
	}
	.arc__tc {
		position: absolute;
		left: 10px;
		bottom: 9px;
		color: var(--color-white);
		text-shadow: 0 1px 6px rgba(0, 0, 0, 0.4);
	}
	.arc__text {
		position: relative;
		z-index: 1;
		/* a little lower, towards the middle of the ring (Max) */
		padding-top: calc(var(--cy) - var(--r) * 0.5);
		text-align: center;
	}
	.arc :global(.arc__title) {
		max-width: 9em;
		margin-inline: auto;
		text-wrap: balance;
	}
	.arc__intro {
		max-width: 440px;
		margin: 24px auto 0;
	}
	.arc__note {
		position: absolute;
		left: var(--edge);
		bottom: clamp(48px, 6vw, 96px);
		font-family: var(--font-scribble);
		font-size: var(--text-h5);
		color: var(--color-rec);
		transform: rotate(-6deg);
	}
	@media (max-width: 699px) {
		/* the ring is wider than the screen here: the text goes under the side photos */
		.arc__text {
			padding-top: calc(var(--cy) - var(--r) * 0.3 + 24px);
		}
		.arc__note {
			display: none;
		}
	}
</style>
