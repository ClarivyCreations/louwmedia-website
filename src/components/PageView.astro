---
import type { ContentEntry } from "emdash";
import type { Page } from "../../emdash-env";
import Blocks from "./Blocks.astro";

interface Props {
	page: ContentEntry<Page>;
	heading?: string;
}

const { page, heading } = Astro.props;
const title = heading ?? page.data.title;
const blocks = page.data.content ?? [];
const hasHero = blocks.some(
	(block) =>
		block._type.startsWith("lm_hero") ||
		block._type === "lm_showreel" ||
		((block._type === "lm_shootday_hero" || block._type === "lm_shootday_clips") && Boolean((block as { hero?: boolean | null }).hero)),
);
---

{
	blocks.length > 0 ? (
		<>
			{!hasHero && (
				<header class="container page-header">
					<h1 class="h1" {...page.edit.title}>{title}</h1>
				</header>
			)}
			<div class="page-blocks" {...page.edit.content}>
				<Blocks value={blocks} />
			</div>
		</>
	) : (
		<section class="container page-header">
			<h1 class="h1">{title}</h1>
			{Astro.locals.user && (
				<p class="text-l muted" style="margin-top:24px">
					Deze pagina heeft nog geen secties.{" "}
					<a class="text-link" href={`/_emdash/admin/content/pages/${page.data.id}`}>Voeg ze toe in de admin</a>
				</p>
			)}
		</section>
	)
}

<style>
	.page-header {
		padding-block: 180px 80px;
	}
</style>
